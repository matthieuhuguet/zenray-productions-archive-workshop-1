NOISE_SD = 0.073   # measured on the fractal noise of this graph, 2026-09-24


def hexlin(h):
    h = h.lstrip('#'); c = [int(h[i:i + 2], 16) / 255 for i in (0, 2, 4)]
    return tuple(x / 12.92 if x <= 0.04045 else ((x + 0.055) / 1.055) ** 2.4 for x in c)


class Engine:
    def __init__(self, net, ctx):
        self.net = net; self.ctx = ctx   # ctx: layout, v, abs_x, tiles_mask, gaps_mask, chips_mask, height
        self.cache = {}

    def mk(self, kind, name, inputs=(), **parms):
        n = self.net.node(name) or self.net.createNode(kind, name)
        for i, src in enumerate(inputs):
            if src is not None:
                n.setInput(i, src[0] if isinstance(src, tuple) else src, src[1] if isinstance(src, tuple) else 0)
        for k, v in parms.items():
            n.parm(k).set(v)
        return n

    def ramp(self, n, pts):
        n.parm('ramp').set(hou.Ramp([hou.rampBasis.Linear] * len(pts), [p for p, _ in pts], [v for _, v in pts]))

    def term(self, dname, i, t):
        key = (dname, i)
        kind = t[0]
        base = f'{dname}_t{i}'
        if kind == 'in_tiles': return self.ctx['tiles']
        if kind == 'in_gaps': return self.ctx['gaps']
        if kind == 'chips': return self.ctx['chips']
        if kind in ('noise', 'line'):
            size, sx, sy, seed = t[1:5]
            nkey = ('noise', size, sx, sy, seed)
            if nkey not in self.cache:
                self.cache[nkey] = self.mk('fractalnoise', f'n_{len(self.cache):02d}_{dname}', elementsize=size,
                                           elementscalex=sx, elementscaley=sy, offx=seed * 13.7, offy=seed * 7.3)
            src = self.cache[nkey]
            r = self.mk('remap', base, [src], inputmin=0, inputmax=1, outputmin=0, outputmax=1, useramp=1)
            if kind == 'noise':
                # coverage -> threshold on the measured distribution (mean 0.5, sd 0.073). / FR : couverture -> seuil
                from statistics import NormalDist
                cov, soft = t[5], (t[6] if len(t) > 6 else 0.25)
                lo = 0.5 + NOISE_SD * NormalDist().inv_cdf(min(max(1 - cov, 1e-4), 1 - 1e-4))
                hi = lo + soft * NOISE_SD
                self.ramp(r, [(0, 0), (max(lo, 0.001), 0), (min(hi, 0.999), 1), (1, 1)])
            else:
                w = t[5]
                self.ramp(r, [(0, 0), (0.5 - w, 0), (0.5, 1), (0.5 + w, 0), (1, 0)])
            return r
        if kind == 'along':        # t = v + 0.5 : 1 at the top, 0 at the bottom lip
            r = self.mk('remap', base, [self.ctx['v']], inputmin=-0.5, inputmax=0.5, useramp=1)
            self.ramp(r, t[1]); return r
        if kind == 'across':
            r = self.mk('remap', base, [self.ctx['across']], inputmin=0, inputmax=1, useramp=1)
            self.ramp(r, t[1]); return r
        if kind == 'tile':
            ratio, seed = t[1], t[2]
            rnd = self.mk('randommono', base + '_rnd', [(self.ctx['layout'], 1), None, None, None, (self.ctx['layout'], 1)], seed=seed)
            return self.mk('remap', base, [rnd], op=1, threshold=1 - ratio)
        if kind == 'curv':
            r = self.mk('remap', base, [self.ctx['curv']], inputmin=0, inputmax=1, useramp=1)
            self.ramp(r, [(0, 0), (t[1], 0), (t[2], 1), (1, 1)]); return r
        raise ValueError(kind)

    def mask(self, d):
        terms = [self.term(d['name'], i, t) for i, t in enumerate(d['mask'])]
        m = terms[0]
        for i, t in enumerate(terms[1:]):
            m = self.mk('blend', f"{d['name']}_and{i}", [m, t], mode=5)
        return self.mk('null', f"{d['name']}_MASK", [m])

    def apply(self, height, color, rough):
        masks = {d['name']: self.mask(d) for d in DETAILS}
        for d in DETAILS:
            m = masks[d['name']]
            if 'height' in d:
                amt = self.mk('remap', f"{d['name']}_h", [m], outputmin=0, outputmax=abs(d['height']), useramp=0)
                height = self.mk('blend', f"{d['name']}_H", [height, amt], mode=3 if d['height'] > 0 else 4)
        for d in DETAILS:
            if 'color' in d:
                hexa, opacity = d['color']
                c = self.mk('constant', f"{d['name']}_col", signature='f3'); c.parmTuple('f3').set(hexlin(hexa))
                op = self.mk('remap', f"{d['name']}_op", [masks[d['name']]], outputmin=0, outputmax=opacity, useramp=0)
                color = self.mk('blend', f"{d['name']}_C", [color, c, op], mode=0)
            if 'rough' in d:
                val, opacity = d['rough']
                rv = self.mk('remap', f"{d['name']}_rv", [masks[d['name']]], outputmin=val, outputmax=val, useramp=0)
                op = self.mk('remap', f"{d['name']}_rop", [masks[d['name']]], outputmin=0, outputmax=opacity, useramp=0)
                rough = self.mk('blend', f"{d['name']}_R", [rough, rv, op], mode=0)
        return height, color, rough
